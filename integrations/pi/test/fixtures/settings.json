          "arg": "--format=brief"
        },
        {
          "value": "detailed",
          "label": "detailed",
          "note": "≈1500 words",
          "arg": "--format=detailed"
        },
        {
          "value": "table",
          "label": "table",
          "note": "tables first",
          "arg": "--format=table"
        }
      ],
      "start": true,
      "review": true,
      "flag": "format"
    },
    {
      "key": "words",
      "label": "words",
      "help": "How long the explanation is, in words. Auto lets the format decide.",
      "value": "0",
      "default": "0",
      "choices": [
        {
          "value": "0",
          "label": "auto",
          "arg": "--words=0"
        },
        {
          "value": "300",
          "label": "300",
