    {
      "key": "tables",
      "label": "tables",
      "help": "How much of the report is in tables. Auto lets the format decide.",
      "value": "auto",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "auto",
          "arg": "--tables=auto"
        },
        {
          "value": "none",
          "label": "none",
          "arg": "--tables=none"
        },
        {
          "value": "some",
          "label": "some",
          "arg": "--tables=some"
        },
        {
          "value": "many",
          "label": "many",
          "arg": "--tables=many"
        }
      ],
      "start": true,
      "review": false,
      "flag": "tables"
    },
    {
      "key": "clarify",
      "label": "clarify",
      "help": "Before planning, ask up to three questions when the question leaves open what to research. Auto asks only when it does.",
      "value": "auto",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "auto",
          "arg": "--clarify=auto"
        },
        {
          "value": "off",
          "label": "off",
          "arg": "--clarify=off"
        }
      ],
      "start": true,
      "review": false,
      "flag": "clarify"
    }
