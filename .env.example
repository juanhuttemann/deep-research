# Secrets / machine-specific overrides for deep-research.
# Copy to .env and fill in your values, or export the matching env var for
# the session. `deep-research init` writes the same file for you.
#
# .env is gitignored and must stay that way.

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-chat
# Web search + scraping. Both must be set to enable web-search mode.
# Setup instructions: docs/services.md.
# SEARXNG_URL=http://localhost:8888
# FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=
